#!/bin/bash


echo "[INFO] Launching cursor app..."
uwsm app -- cursor >/dev/null 2>&1 & disown

sleep 1
echo "[INFO] Launching Firefox Developer Edition..."
uwsm app -- firefox-developer-edition >/dev/null 2>&1 & disown

sleep 1
echo "[INFO] Launching Slack..."
uwsm app -- slack >/dev/null 2>&1 & disown

if command -v notify-send >/dev/null 2>&1; then
  notify-send "Dev UI" "All apps launched successfully!"
fi

