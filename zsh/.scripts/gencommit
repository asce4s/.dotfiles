#!/bin/bash

# Get git diff
GIT_DIFF=$(git diff --cached 2>/dev/null)

# Very direct prompt
PROMPT="Write a conventional commit message for this diff. Format: type(scope): description. Only output the commit message:

$GIT_DIFF"

# Use cursor-agent -p and extract just the commit message
cursor-agent -p "$PROMPT" --model "cheetah" | grep -E "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|config)" | head -1
