#!/usr/bin/env bash

if ! command -v cliphist >/dev/null; then
	notify-send -u critical "cliphist" "Not installed — run: pacman -S cliphist"
	exit 1
fi

dir="$HOME/.config/rofi/launchers/type-1"
theme='style-5'

selected="$(cliphist list | rofi -dmenu -p "Clipboard" -theme "${dir}/${theme}.rasi")"
[[ -z "$selected" ]] && exit 0

printf '%s' "$selected" | cliphist decode | wl-copy
